<Window x:Class="RdpShadow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RdpShadow.App"
        Title="RDP Shadow" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft"
        Icon="Assets/app.ico"
        StateChanged="Window_StateChanged" Closed="Window_Closed">
    <Grid>
        <!-- ================= Shell: navigation + settings pages ================= -->
        <Grid x:Name="Shell">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="12,8,12,12">
                <Grid DockPanel.Dock="Top" Margin="0,4,0,12">
                    <TextBox x:Name="SearchBox" Height="34" TextChanged="SearchBox_TextChanged" AutomationProperties.Name="חיפוש מחשב" />
                    <TextBlock Text="חיפוש מחשב" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="Nav_SelectionChanged">
                    <ListBoxItem Tag="{Binding ElementName=ComputersPage}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,0,14,0" /><TextBlock Text="מחשבים" FontSize="14" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{Binding ElementName=ClipboardPage}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" Margin="0,0,14,0" /><TextBlock Text="לוח" FontSize="14" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{Binding ElementName=QualityPage}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" Margin="0,0,14,0" /><TextBlock Text="איכות תצוגה" FontSize="14" /></StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="{Binding ElementName=PreparePage}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" Margin="0,0,14,0" /><TextBlock Text="הכנת מחשב" FontSize="14" /></StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1">
                <!-- Computers -->
                <ScrollViewer x:Name="ComputersPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="40,12,56,32">
                        <DockPanel Margin="0,0,0,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid>
                                    <TextBox x:Name="NewHostBox" Width="220" Height="32" FlowDirection="LeftToRight" KeyDown="NewHostBox_KeyDown"
                                             AutomationProperties.Name="כתובת IP או שם מחשב" />
                                    <TextBlock Text="כתובת IP או שם מחשב" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=NewHostBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Margin="8,0,0,0" Height="32" Click="AddComputer_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE710;" Margin="0,0,8,0" /><TextBlock Text="הוסף מחשב" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="מחשבים" Style="{StaticResource PageTitle}" Margin="0" />
                        </DockPanel>

                        <TextBlock x:Name="ComputersNotice" Style="{StaticResource Hint}" Margin="0,0,0,10" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        <ItemsControl x:Name="ComputerList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:Computer}">
                                    <Border Style="{StaticResource Card}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="26" Text="&#xE7F4;" Margin="0,0,16,0" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding ShadowColor}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding ShadowText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding AgentColor}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding AgentText}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <Button Content="הכן מחשב" Height="32" Margin="0,0,8,0" Click="PrepareComputer_Click"
                                                        Visibility="{Binding NeedsAgent, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Content="עדכן Agent" Height="32" Margin="0,0,8,0" Click="UpdateAgent_Click"
                                                        ToolTip="יש גרסה חדשה של ה-Agent ליד האפליקציה"
                                                        Visibility="{Binding AgentOutdated, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Content="צפייה" Height="32" MinWidth="72" Margin="0,0,8,0" Click="View_Click" IsEnabled="{Binding CanConnect}" />
                                                <Button Content="שליטה" Height="32" MinWidth="72" Style="{DynamicResource AccentButtonStyle}" Click="Control_Click" IsEnabled="{Binding CanConnect}" />
                                                <Button Width="36" Height="32" Padding="0" Margin="8,0,0,0" Click="RemoveComputer_Click" ToolTip="הסר מהרשימה"
                                                        AutomationProperties.Name="הסר מהרשימה" Background="Transparent" BorderThickness="0">
                                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Host}" Style="{StaticResource CardTitle}" />
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource CardDescription}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyHint" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   Text="עוד לא הוספת מחשבים. הקלד כתובת IP או שם מחשב ולחץ &quot;הוסף מחשב&quot;." />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0"
                                   Text="הסטטוס מתעדכן כל 10 שניות. &quot;לא עונה&quot; = המחשב לא זמין בפורט 3389 (RDP)." />
                    </StackPanel>
                </ScrollViewer>

                <!-- Clipboard -->
                <ScrollViewer x:Name="ClipboardPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,12,56,32">
                        <TextBlock Text="לוח" Style="{StaticResource PageTitle}" />

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="20" Text="&#xE77F;" Margin="0,0,16,0" />
                                <CheckBox x:Name="ClipEnabled" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="ClipSetting_Changed" AutomationProperties.Name="סנכרון לוח" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="סנכרון לוח" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="מעתיקים אצלך ומדביקים במחשב המחובר, ולהפך" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="20" Text="&#xE8AB;" Margin="0,0,16,0" />
                                <ComboBox x:Name="ClipDirectionBox" DockPanel.Dock="Right" MinWidth="200" VerticalAlignment="Center"
                                          SelectionChanged="ClipSetting_Changed" AutomationProperties.Name="כיוון">
                                    <ComboBoxItem Content="דו-כיווני" />
                                    <ComboBoxItem Content="רק מהמחשב המרוחק אליי" />
                                    <ComboBoxItem Content="רק ממני למחשב המרוחק" />
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="כיוון" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="לאן מותר להעביר תוכן" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="מה עובר בלוח" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="20" Text="&#xE8D2;" Margin="0,0,16,0" />
                                <CheckBox x:Name="ClipText" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="ClipSetting_Changed" AutomationProperties.Name="טקסט" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="טקסט" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="כולל עיצוב מ-Word, Excel והדפדפן" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="20" Text="&#xEB9F;" Margin="0,0,16,0" />
                                <CheckBox x:Name="ClipImages" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="ClipSetting_Changed" AutomationProperties.Name="תמונות" />
                                <TextBlock Text="תמונות וצילומי מסך" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="20" Text="&#xE8B7;" Margin="0,0,16,0" />
                                <CheckBox x:Name="ClipFiles" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="ClipSetting_Changed" AutomationProperties.Name="קבצים" />
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="עד" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBox x:Name="ClipMaxBox" Width="64" Margin="8,0" TextAlignment="Center" FlowDirection="LeftToRight"
                                             LostFocus="ClipSetting_Changed" AutomationProperties.Name="גודל מרבי במגה-בייט" />
                                    <TextBlock Text="MB" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="קבצים ותיקיות" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="מועתקים במלואם לצד השני, ואז מדביקים כרגיל" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="איך זה עובד" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardDescription}" Margin="0"
                                           Text="• כל פריט שעובר נכנס להיסטוריית הלוח (Win+V) בשני המחשבים. קבצים לא נשמרים שם, זו מגבלה של Windows." />
                                <TextBlock Style="{StaticResource CardDescription}"
                                           Text="• הסנכרון מושהה כשהחלון ממוזער. כשחוזרים, מה שהעתקת בינתיים נשלח מיד." />
                                <TextBlock Style="{StaticResource CardDescription}"
                                           Text="• תוכן שתוכנות סיסמאות מסמנות כפרטי לא מועבר." />
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="ClipLastSync" Style="{StaticResource Hint}" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Quality -->
                <ScrollViewer x:Name="QualityPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,12,56,32">
                        <DockPanel Margin="0,0,0,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="QualityHostBox" MinWidth="220" FlowDirection="LeftToRight" SelectionChanged="QualityHost_Changed" AutomationProperties.Name="מחשב" />
                                <Button x:Name="QualityApplyButton" Content="החל על המחשב" Height="32" Margin="8,0,0,0"
                                        Style="{DynamicResource AccentButtonStyle}" Click="QualityApply_Click" />
                            </StackPanel>
                            <TextBlock Text="איכות תצוגה" Style="{StaticResource PageTitle}" Margin="0" />
                        </DockPanel>

                        <UniformGrid Columns="3" Margin="0,0,-8,0">
                            <RadioButton x:Name="ProfileEco" GroupName="Profile" Style="{StaticResource ChoiceCard}" Checked="Profile_Checked">
                                <StackPanel>
                                    <TextBlock Text="חסכוני" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="רשת איטית או VPN. 30 fps" Style="{StaticResource CardDescription}" Margin="0,6,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ProfileBalanced" GroupName="Profile" Style="{StaticResource ChoiceCard}" Checked="Profile_Checked">
                                <StackPanel>
                                    <TextBlock Text="מאוזן" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="רוב המקרים. 30 fps, H.264 בהאצת חומרה" Style="{StaticResource CardDescription}" Margin="0,6,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ProfileMax" GroupName="Profile" Style="{StaticResource ChoiceCard}" Checked="Profile_Checked">
                                <StackPanel>
                                    <TextBlock Text="איכות מקסימלית" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="רשת מקומית. 60 fps, AVC 4:4:4, טקסט חד" Style="{StaticResource CardDescription}" Margin="0,6,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <TextBlock Text="מתקדם" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox x:Name="QFps60" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="QualityToggle_Click" AutomationProperties.Name="60 פריימים בשנייה" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="60 פריימים בשנייה" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="תנועה חלקה יותר. ברירת המחדל של Windows היא 30" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox x:Name="QAvc444" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="QualityToggle_Click" AutomationProperties.Name="AVC 4:4:4" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="קידוד H.264/AVC 4:4:4" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="צבעים וטקסט חדים יותר, עומס מעבד גבוה יותר" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox x:Name="QHardware" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="QualityToggle_Click" AutomationProperties.Name="האצת חומרה" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="האצת חומרה בקידוד" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="משתמש בכרטיס המסך של המחשב המרוחק" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" MinHeight="0" Margin="0,14,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,10,0" />
                                <TextBlock x:Name="QualityStatus" Style="{StaticResource Hint}" VerticalAlignment="Center"
                                           Text="ההגדרות נכתבות במחשב המרוחק דרך ה-Agent ונכנסות לתוקף בחיבור הבא." />
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Prepare -->
                <ScrollViewer x:Name="PreparePage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="40,12,56,32">
                        <DockPanel Margin="0,0,0,18">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="PrepareHostBox" MinWidth="220" FlowDirection="LeftToRight" SelectionChanged="PrepareHost_Changed" AutomationProperties.Name="מחשב" />
                                <Button Width="36" Height="32" Padding="0" Margin="8,0,0,0" Click="PrepareRefresh_Click" ToolTip="רענן" AutomationProperties.Name="רענן">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE72C;" />
                                </Button>
                                <Button x:Name="FixAllButton" Content="תקן הכל" Height="32" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}" Click="FixAll_Click" />
                            </StackPanel>
                            <TextBlock Text="הכנת מחשב" Style="{StaticResource PageTitle}" Margin="0" />
                        </DockPanel>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock x:Name="PAgent" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Agent לסנכרון לוח" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="שירות קטן במחשב המרוחק. נדרש כדי שהלוח יעבור ב-Shadow, ומפעיל את כל ההגדרות שבעמוד הזה" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock x:Name="PRdp" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="שולחן עבודה מרוחק פעיל" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="fDenyTSConnections = 0" Style="{StaticResource CardDescription}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock x:Name="PRpc" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="גישה לרשימת הסשנים מרחוק" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="AllowRemoteRPC = 1" Style="{StaticResource CardDescription}" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <TextBlock x:Name="PFirewall" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="13" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="חומת אש" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Remote Desktop, Shadow ופורט ה-Agent (47800)" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <ComboBox x:Name="PShadowBox" DockPanel.Dock="Right" MinWidth="220" VerticalAlignment="Center" AutomationProperties.Name="הרשאת Shadow">
                                    <ComboBoxItem Content="שליטה מלאה עם אישור" Tag="1" />
                                    <ComboBoxItem Content="שליטה מלאה בלי אישור" Tag="2" />
                                    <ComboBoxItem Content="צפייה בלבד עם אישור" Tag="3" />
                                    <ComboBoxItem Content="צפייה בלבד בלי אישור" Tag="4" />
                                </ComboBox>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="הרשאת Shadow" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="PShadowNow" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <CheckBox x:Name="PClipHistory" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="True" AutomationProperties.Name="היסטוריית לוח" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="היסטוריית לוח (Win+V) במחשב המרוחק" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="מפעיל את Win+V למשתמש המחובר, כדי שכל מה שעובר יופיע שם" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <TextBlock Text="התחברות" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox x:Name="CredUser" Width="150" FlowDirection="LeftToRight" AutomationProperties.Name="שם משתמש" ToolTip="שם משתמש, למשל PC-NAME\admin" />
                                    <PasswordBox x:Name="CredPassword" Width="150" Margin="8,0" FlowDirection="LeftToRight" AutomationProperties.Name="סיסמה" />
                                    <Button Content="שמור" Height="32" Click="SaveCredentials_Click" />
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="פרטי מנהל למחשב הזה" Style="{StaticResource CardTitle}" />
                                    <TextBlock x:Name="CredStatus" Style="{StaticResource CardDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock x:Name="PrepareStatus" Style="{StaticResource Hint}" Margin="0,14,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ================= Session: shadow view ================= -->
        <!-- Hidden (not Collapsed) so the HwndHost exists before the first connect -->
        <DockPanel x:Name="SessionView" Visibility="Hidden">
            <Border DockPanel.Dock="Top" Height="52" Padding="12,0" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <DockPanel>
                    <Ellipse x:Name="SessionDot" Width="8" Height="8" Fill="#6CCB5F" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SessionHost" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock x:Name="SessionDetail" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="ClipPill" CornerRadius="14" Height="28" Padding="10,0" Margin="0,0,10,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ClipPillIcon" Style="{StaticResource Icon}" FontSize="13" Text="&#xE77F;" Margin="0,0,6,0" />
                                <TextBlock x:Name="ClipPillText" FontSize="12" VerticalAlignment="Center" Text="לוח: מתחבר..." />
                                <ProgressBar x:Name="ClipProgress" Width="70" Height="4" MinHeight="4" Margin="8,0,0,0" VerticalAlignment="Center"
                                             Visibility="Collapsed" AutomationProperties.Name="התקדמות העברה" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="5" BorderThickness="1" Padding="2" Margin="0,0,10,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ModeView" Content="צפייה" GroupName="Mode" Style="{DynamicResource {x:Type ToggleButton}}" Height="26" Padding="14,0" Click="Mode_Click" />
                                <RadioButton x:Name="ModeControl" Content="שליטה" GroupName="Mode" Style="{DynamicResource {x:Type ToggleButton}}" Height="26" Padding="14,0" Margin="2,0,0,0" Click="Mode_Click" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="ColorButton" Width="36" Height="32" Padding="0" Margin="0,0,6,0" Click="ColorButton_Click" ToolTip="בהירות וניגודיות" AutomationProperties.Name="בהירות וניגודיות">
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE706;" />
                        </Button>
                        <!-- Popup: a separate window, so it draws above the hosted viewer and the color filter -->
                        <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}" Placement="Bottom" StaysOpen="False"
                               Closed="ColorPopup_Closed">
                            <Border Width="300" Padding="16,12" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:+0;-0;0}}" />
                                        <TextBlock Text="בהירות" />
                                    </DockPanel>
                                    <Slider x:Name="BrightnessSlider" Minimum="-50" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Margin="0,4,0,12" ValueChanged="Color_Changed" AutomationProperties.Name="בהירות" />
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ContrastSlider, StringFormat={}{0}%}" />
                                        <TextBlock Text="ניגודיות" />
                                    </DockPanel>
                                    <Slider x:Name="ContrastSlider" Minimum="50" Maximum="150" Value="100" IsSnapToTickEnabled="True" TickFrequency="1"
                                            Margin="0,4,0,12" ValueChanged="Color_Changed" AutomationProperties.Name="ניגודיות" />
                                    <Button Content="איפוס" HorizontalAlignment="Left" Click="ColorReset_Click" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button Width="36" Height="32" Padding="0" Margin="0,0,6,0" Click="Fit_Click" ToolTip="התאם לחלון / גודל מקורי" AutomationProperties.Name="התאם לחלון">
                            <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE9A6;" />
                        </Button>
                        <Button Width="36" Height="32" Padding="0" Margin="0,0,6,0" Click="FullScreen_Click" ToolTip="מסך מלא" AutomationProperties.Name="מסך מלא">
                            <TextBlock x:Name="FullScreenIcon" Style="{StaticResource Icon}" FontSize="14" Text="&#xE740;" />
                        </Button>
                        <Button Height="32" Click="Disconnect_Click" Foreground="{DynamicResource SystemFillColorCriticalBrush}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" FontSize="13" Text="&#xE7E8;" Margin="0,0,8,0" /><TextBlock Text="נתק" /></StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Margin="8" CornerRadius="6" BorderThickness="1" ClipToBounds="True" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <TextBlock x:Name="SessionPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <!-- LTR: an RTL HwndHost would mirror the remote screen -->
                    <local:ShadowHost x:Name="Shadow" FlowDirection="LeftToRight" />
                </Grid>
            </Border>
        </DockPanel>

        <!-- Popup, not an overlay: WPF content can't draw over the hosted mstsc window (airspace) -->
        <Popup x:Name="Toast" PlacementTarget="{Binding ElementName=SessionView}" Placement="Relative" AllowsTransparency="True"
               StaysOpen="True" IsHitTestVisible="False">
            <Border Padding="16,12" CornerRadius="8" BorderThickness="1" Margin="0,0,0,0"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE77F;" FontSize="18" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock x:Name="ToastTitle" FontSize="13" />
                        <TextBlock x:Name="ToastText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
